{
  "AllowedHosts": "*",
  "ApiSettings": {
    "Title": "Archdraw API",
    "Version": "1.0",
    "Description": "API da plataforma Archdraw de engenharia e arquitetura de software"
  },
  "Swagger": {
    "Username": "swagger"
  },
  "Jwt": {
    "key": ""
  },
  "TokenConfiguration": {
    "Issuer": "archdraw-api",
    "Audience": "archdraw-clients",
    "AccessTokenExpireMinutes": "15",
    "RefreshTokenExpireDays": "30"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10,
    "RefreshPermitPerMinute": 60
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "BackgroundJobs": {
    "Enabled": false
  },
  "BrevoSettings": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "Archdraw"
  },
  "AwsSettings": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "auto",
    "EndpointUrl": "",
    "PublicBucketName": "",
    "PublicBaseUrl": ""
  },
  "LocalStorage": {
    "RootPath": "uploads",
    "PublicBaseUrl": "http://localhost:5080/uploads"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Redis": {
    "InstanceName": "archdraw:"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}